# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Deployment Python dependencies, installed by the [deployment] build step in
# .replit. These MUST reach the runtime image — the backend cannot import
# uvicorn/fastapi without them.
#
# Re-included last, on purpose: the generic patterns above (*.so, lib/, build/,
# __pycache__/, *.py[cod]) would otherwise strip compiled extension modules such
# as pydantic_core, cryptography and psycopg2 out of this directory, leaving a
# tree that looks complete but fails to import at runtime. Later patterns win,
# so these negations must stay at the end of this file.
!.deploy-python/
!.deploy-python/**

# Compiled frontend, produced by the [deployment] build step (npm run build).
# It MUST reach the runtime image — uvicorn serves it directly in production
# (SERVE_FRONTEND_DIST=true, see start-prod.sh). Re-included last so the
# generic dist/ and frontend/dist/ exclusions above don't strip it.
!frontend/dist/
!frontend/dist/**
